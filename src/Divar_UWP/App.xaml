<Application
    x:Class="Divar_UWP.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Divar_UWP"
    xmlns:converters="using:Divar_UWP.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="DivarPageBrush" Color="#FFFAFAFA" />
                    <SolidColorBrush x:Key="DivarSurfaceBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="DivarElevatedSurfaceBrush" Color="#FFF5F5F5" />
                    <SolidColorBrush x:Key="DivarTextBrush" Color="#FF242424" />
                    <SolidColorBrush x:Key="DivarMutedTextBrush" Color="#FF757575" />
                    <SolidColorBrush x:Key="DivarSubtleTextBrush" Color="#FF9E9E9E" />
                    <SolidColorBrush x:Key="DivarDividerBrush" Color="#1F000000" />
                    <SolidColorBrush x:Key="DivarFieldBrush" Color="#FFF5F5F5" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="DivarPageBrush" Color="#FF18181A" />
                    <SolidColorBrush x:Key="DivarSurfaceBrush" Color="#FF1E1E20" />
                    <SolidColorBrush x:Key="DivarElevatedSurfaceBrush" Color="#FF252529" />
                    <SolidColorBrush x:Key="DivarTextBrush" Color="#FFF1F1F1" />
                    <SolidColorBrush x:Key="DivarMutedTextBrush" Color="#FFA6A6AA" />
                    <SolidColorBrush x:Key="DivarSubtleTextBrush" Color="#FF77777C" />
                    <SolidColorBrush x:Key="DivarDividerBrush" Color="#24FFFFFF" />
                    <SolidColorBrush x:Key="DivarFieldBrush" Color="#FF29292E" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="DivarPageBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="DivarSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="DivarElevatedSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="DivarTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="DivarMutedTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="DivarSubtleTextBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
                    <SolidColorBrush x:Key="DivarDividerBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="DivarFieldBrush" Color="{ThemeResource SystemColorWindowColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <Color x:Key="DivarAccentColor">#FFE14444</Color>
            <SolidColorBrush x:Key="DivarAccentBrush" Color="{StaticResource DivarAccentColor}" />
            <SolidColorBrush x:Key="DivarAccentTintBrush" Color="#22E14444" />
            <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
            <converters:ThumbnailConverter x:Key="ThumbnailConverter" />
            <converters:PreviewImageConverter x:Key="PreviewImageConverter" />

            <DataTemplate x:Key="DivarPostCardTemplate">
                <Grid MinHeight="116" Padding="16,10" BorderBrush="{ThemeResource DivarDividerBrush}" BorderThickness="0,0,0,1">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="104" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Width="96" Height="96" CornerRadius="4" Background="{ThemeResource DivarElevatedSurfaceBrush}" HorizontalAlignment="Right">
                        <Image Source="{Binding ThumbnailUrl, Converter={StaticResource ThumbnailConverter}}" Stretch="UniformToFill" />
                    </Border>
                    <Grid Grid.Column="1" Margin="12,0,0,0">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock Text="{Binding Title}" Foreground="{ThemeResource DivarTextBrush}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="2" />
                        <StackPanel Grid.Row="1" VerticalAlignment="Bottom">
                            <TextBlock Text="{Binding TopDescription}" Foreground="{ThemeResource DivarMutedTextBrush}" FontFamily="Segoe UI" FontSize="14" Visibility="{Binding TopDescription, Converter={StaticResource StringToVisibilityConverter}}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding MiddleDescription}" Foreground="{ThemeResource DivarTextBrush}" FontSize="14" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock Grid.Row="2" Text="{Binding BottomDescription}" Foreground="{ThemeResource DivarMutedTextBrush}" FontSize="12" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Row="3" Margin="0,3,0,0" Text="{Binding BadgeText}" Foreground="{StaticResource DivarAccentBrush}" FontSize="12" Visibility="{Binding BadgeText, Converter={StaticResource StringToVisibilityConverter}}" />
                    </Grid>
                </Grid>
            </DataTemplate>

            <Style x:Key="DivarPageTitleStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource DivarTextBrush}" />
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="FontSize" Value="24" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="DivarSectionTitleStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource DivarTextBrush}" />
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="DivarBodyStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource DivarMutedTextBrush}" />
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="LineHeight" Value="24" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="DivarPrimaryButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource DivarAccentBrush}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="BorderBrush" Value="{StaticResource DivarAccentBrush}" />
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="MinHeight" Value="44" />
                <Setter Property="Padding" Value="18,10" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
            </Style>
            <Style x:Key="DivarSecondaryButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{StaticResource DivarAccentBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource DivarAccentBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="MinHeight" Value="44" />
                <Setter Property="Padding" Value="16,9" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
            </Style>
            <Style x:Key="DivarTextBoxStyle" TargetType="TextBox">
                <Setter Property="Background" Value="{ThemeResource DivarFieldBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource DivarTextBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource DivarDividerBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="MinHeight" Value="44" />
                <Setter Property="Padding" Value="12,8" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
