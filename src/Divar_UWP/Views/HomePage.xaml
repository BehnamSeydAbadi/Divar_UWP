<Page
    x:Class="Divar_UWP.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    FlowDirection="RightToLeft"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Padding="24">
        <StackPanel MaxWidth="480" HorizontalAlignment="Stretch" VerticalAlignment="Center">
            <TextBlock Text="{Binding Title}" FontSize="32" FontWeight="SemiBold" />
            <TextBlock Margin="0,12,0,24" Text="اسکلت بومی صفحه اصلی؛ بدون نمای وب و بدون دادهٔ آزمایشی شبکه." TextWrapping="Wrap" />
            <Button Content="جستجو" Command="{Binding SearchCommand}" HorizontalAlignment="Stretch" />
            <Button Margin="0,12,0,0" Content="مشاهده فهرست آگهی‌ها" Command="{Binding BrowseCommand}" HorizontalAlignment="Stretch" />
        </StackPanel>
    </Grid>
</Page>
