<Page
    x:Class="Divar_UWP.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" FlowDirection="RightToLeft" Background="{ThemeResource DivarPageBrush}">
    <Grid Padding="18,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="خوش آمدید" Style="{StaticResource DivarPageTitleStyle}" />
            <Button Margin="0,10,0,0" Command="{Binding ChangeCityCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Right" Background="{StaticResource DivarAccentTintBrush}" BorderThickness="0" Padding="12,9">
                <StackPanel Orientation="Horizontal">
                    <FontIcon Glyph="&#xE707;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource DivarAccentBrush}" FontSize="17" />
                    <Border Width="10" />
                    <StackPanel>
                        <TextBlock Text="{Binding SelectedCityName}" Foreground="{ThemeResource DivarTextBrush}" FontWeight="SemiBold" />
                        <TextBlock Text="تغییر شهر" Foreground="{ThemeResource DivarMutedTextBrush}" FontSize="11" />
                    </StackPanel>
                </StackPanel>
            </Button>
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="0,16,0,8" Orientation="Horizontal" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ProgressRing Width="22" Height="22" IsActive="{Binding IsLoading}" Foreground="{StaticResource DivarAccentBrush}" />
            <TextBlock Margin="10,0,0,0" Text="در حال دریافت دسته‌بندی‌های دیوار…" Style="{StaticResource DivarBodyStyle}" VerticalAlignment="Center" />
        </StackPanel>
        <Border Grid.Row="2" Margin="0,6,0,10" Padding="14" Background="{StaticResource DivarAccentTintBrush}" Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel>
                <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource DivarBodyStyle}" />
                <Button Margin="0,10,0,0" Content="تلاش دوباره" HorizontalAlignment="Right" Style="{StaticResource DivarSecondaryButtonStyle}" Click="OnRetryClick" />
            </StackPanel>
        </Border>
        <TextBlock Grid.Row="3" Margin="0,8,0,10" Text="دسته‌بندی‌ها" Style="{StaticResource DivarSectionTitleStyle}" />
        <ListView Grid.Row="4" ItemsSource="{Binding Categories}" IsItemClickEnabled="True" ItemClick="OnCategoryItemClick" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid MinHeight="48" Padding="8,3">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="{StaticResource DivarAccentBrush}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Margin="12,0" Text="{Binding Name}" Foreground="{ThemeResource DivarTextBrush}" FontSize="15" VerticalAlignment="Center" />
                        <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{ThemeResource DivarSubtleTextBrush}" VerticalAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <Button Grid.Row="5" Margin="0,12,0,0" Content="مشاهده همهٔ دسته‌بندی‌ها" Command="{Binding OpenCategoriesCommand}" HorizontalAlignment="Stretch" Style="{StaticResource DivarPrimaryButtonStyle}" />
    </Grid>
</Page>
