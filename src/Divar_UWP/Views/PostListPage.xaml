<Page
    x:Class="Divar_UWP.Views.PostListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" FlowDirection="RightToLeft" Background="{ThemeResource DivarPageBrush}">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid Padding="20,10,20,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding FeedTitle}" Style="{StaticResource DivarPageTitleStyle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <Button Grid.Column="1" Margin="10,0,0,0" Content="{Binding FilterButtonText}" Command="{Binding OpenFiltersCommand}" Style="{StaticResource DivarSecondaryButtonStyle}" />
        </Grid>
        <Border Grid.Row="1" BorderBrush="{ThemeResource DivarDividerBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <ListView ItemsSource="{Binding Posts}"
                          IncrementalLoadingTrigger="Edge"
                          IncrementalLoadingThreshold="2"
                          SelectionMode="None"
                          IsItemClickEnabled="True" ItemClick="OnPostItemClick"
                          ItemTemplate="{StaticResource DivarPostCardTemplate}">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.Footer>
                        <ProgressRing Margin="0,14" Width="26" Height="26" IsActive="{Binding IsLoadingNextPage}" Visibility="{Binding IsLoadingNextPage, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </ListView.Footer>
                </ListView>

                <StackPanel Margin="24" VerticalAlignment="Center" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ProgressRing IsActive="True" Width="34" Height="34" />
                    <TextBlock Margin="0,12,0,0" Text="در حال دریافت آگهی‌ها…" Style="{StaticResource DivarBodyStyle}" TextAlignment="Center" />
                </StackPanel>
                <StackPanel Margin="24" VerticalAlignment="Center" Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource DivarBodyStyle}" TextAlignment="Center" />
                    <Button Margin="0,18,0,0" Content="تلاش دوباره" Click="OnRetryClick" Style="{StaticResource DivarPrimaryButtonStyle}" />
                </StackPanel>
                <StackPanel Margin="24" VerticalAlignment="Center" Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" Foreground="{ThemeResource DivarSubtleTextBrush}" FontSize="42" HorizontalAlignment="Center" />
                    <TextBlock Margin="0,14,0,0" Text="آگهی‌ای پیدا نشد" Style="{StaticResource DivarSectionTitleStyle}" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
