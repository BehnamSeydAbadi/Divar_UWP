<Page
    x:Class="Divar_UWP.Views.CitySelectionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    FlowDirection="RightToLeft"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Padding="24">
        <StackPanel MaxWidth="480" HorizontalAlignment="Stretch" VerticalAlignment="Center">
            <TextBlock Text="{Binding Title}" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Margin="0,12,0,24" Text="فهرست شهرها در برش بعدی به سرویس شهر متصل می‌شود." TextWrapping="Wrap" />
            <Button Content="ادامه به صفحه اصلی" Command="{Binding ContinueCommand}" HorizontalAlignment="Stretch" />
        </StackPanel>
    </Grid>
</Page>
