<Page
    x:Class="Divar_UWP.Views.CategoriesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" FlowDirection="RightToLeft" Background="{ThemeResource DivarPageBrush}">
    <Grid Padding="18,16">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid FlowDirection="LeftToRight">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="بازگشت" Margin="0,0,12,0" FlowDirection="RightToLeft" HorizontalAlignment="Left" Background="Transparent" Foreground="{StaticResource DivarAccentBrush}" BorderThickness="0" Visibility="{Binding CanGoUp, Converter={StaticResource BooleanToVisibilityConverter}}" Click="OnGoUpClick" />
            <TextBlock Grid.Column="1" Text="{Binding CurrentTitle}" Style="{StaticResource DivarPageTitleStyle}" FlowDirection="RightToLeft" TextAlignment="Right" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" VerticalAlignment="Center" HorizontalAlignment="Stretch" />
        </Grid>
        <StackPanel Grid.Row="1" Margin="0,14,0,8" Orientation="Horizontal" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ProgressRing Width="22" Height="22" IsActive="{Binding IsLoading}" Foreground="{StaticResource DivarAccentBrush}" />
            <TextBlock Margin="10,0,0,0" Text="در حال دریافت دسته‌بندی‌ها…" Style="{StaticResource DivarBodyStyle}" VerticalAlignment="Center" />
        </StackPanel>
        <Border Grid.Row="2" Margin="0,6,0,10" Padding="14" Background="{StaticResource DivarAccentTintBrush}" Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel>
                <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource DivarBodyStyle}" />
                <Button Margin="0,10,0,0" Content="تلاش دوباره" HorizontalAlignment="Right" Style="{StaticResource DivarSecondaryButtonStyle}" Click="OnRetryClick" />
            </StackPanel>
        </Border>
        <ListView Grid.Row="3" ItemsSource="{Binding Categories}" IsItemClickEnabled="True" ItemClick="OnCategoryItemClick" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid MinHeight="52" Padding="8,4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{StaticResource DivarAccentBrush}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" Foreground="{ThemeResource DivarTextBrush}" FontSize="15" />
                            <TextBlock Text="زیر‌دسته‌ها" Foreground="{ThemeResource DivarMutedTextBrush}" FontSize="11" Visibility="{Binding HasChildren, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </StackPanel>
                        <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{ThemeResource DivarSubtleTextBrush}" VerticalAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <TextBlock Grid.Row="4" Margin="0,10,0,0" Text="{Binding StatusMessage}" Foreground="{StaticResource DivarAccentBrush}" TextWrapping="Wrap" />
    </Grid>
</Page>
