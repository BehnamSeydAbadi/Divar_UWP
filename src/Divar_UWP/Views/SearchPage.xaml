<Page
    x:Class="Divar_UWP.Views.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    FlowDirection="RightToLeft"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Padding="24">
        <StackPanel MaxWidth="480" HorizontalAlignment="Stretch" VerticalAlignment="Center">
            <TextBlock Text="{Binding Title}" FontSize="28" FontWeight="SemiBold" />
            <TextBox Margin="0,16,0,12" Header="عبارت جستجو" PlaceholderText="مثلاً موبایل" />
            <Button Content="نمایش صفحه نتایج خالی" Command="{Binding ShowResultsCommand}" HorizontalAlignment="Stretch" />
        </StackPanel>
    </Grid>
</Page>
