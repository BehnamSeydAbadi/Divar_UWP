<Page
    x:Class="Divar_UWP.Views.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" FlowDirection="RightToLeft" Background="{ThemeResource DivarPageBrush}">
    <Grid Padding="20">
        <StackPanel MaxWidth="480" HorizontalAlignment="Stretch">
            <TextBlock Text="{Binding Title}" Style="{StaticResource DivarPageTitleStyle}" />
            <TextBox Margin="0,18,0,12" Style="{StaticResource DivarTextBoxStyle}" PlaceholderText="مثلاً پراید"
                     Text="{Binding Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" KeyDown="OnSearchKeyDown" />
            <Button Margin="0,24,0,0" Content="نمایش نتایج" Command="{Binding ShowResultsCommand}" HorizontalAlignment="Stretch" Style="{StaticResource DivarPrimaryButtonStyle}" />
            <ProgressRing Margin="0,24,0,0" Width="24" Height="24" IsActive="{Binding IsLoadingSuggestions}" Visibility="{Binding IsLoadingSuggestions, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <TextBlock Margin="0,16,0,0" Text="{Binding SuggestionMessage}" Style="{StaticResource DivarBodyStyle}" Visibility="{Binding SuggestionMessage, Converter={StaticResource StringToVisibilityConverter}}" />
            <ListView Margin="0,18,0,0" ItemsSource="{Binding Suggestions}" IsItemClickEnabled="True" ItemClick="OnSuggestionClick" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Padding="12,10">
                            <TextBlock Text="{Binding Title}" Foreground="{ThemeResource DivarTextBrush}" FontSize="15" />
                            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource DivarBodyStyle}" Visibility="{Binding Subtitle, Converter={StaticResource StringToVisibilityConverter}}" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </Grid>
</Page>
